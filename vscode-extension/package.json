{
  "name": "accessibu11y-vscode",
  "displayName": "Accessibu11y",
  "description": "Quick accessibility checks inspired by the Accessibu11y Chrome extension.",
  "version": "0.2.0",
  "publisher": "accessibu11y",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Linters", "Other"],
  "keywords": ["accessibility", "a11y", "WCAG"],
  "activationEvents": [
    "onLanguage:html", "onLanguage:javascriptreact", "onLanguage:typescriptreact",
    "onLanguage:css", "onLanguage:scss", "onCommand:accessibu11y.scanWorkspace"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      { "command": "accessibu11y.scanWorkspace", "title": "Accessibu11y: Scan Workspace" }
    ]
  }
}
